{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universaarl:schema:portable-snapshot-pilot:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "projectId", "customerId", "classification", "simulation", "sourceInventory", "deltaContract", "knowledgeChanges", "coverage", "contradictions", "brownfieldReconciliation", "release", "customerCatalog"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "UABC-PORTABLE-SNAPSHOT-PILOT-V1" },
    "projectId": { "const": "UABC-BC-BASIC-001" },
    "customerId": { "const": "UABC-CUSTOMER-001" },
    "classification": { "const": "synthetic-local-simulation" },
    "simulation": { "const": true },
    "sourceInventory": { "type": "object" },
    "deltaContract": { "type": "object" },
    "knowledgeChanges": { "type": "array", "minItems": 1 },
    "coverage": { "type": "array", "minItems": 1 },
    "contradictions": { "type": "array", "minItems": 1 },
    "brownfieldReconciliation": { "type": "object" },
    "release": {
      "type": "object",
      "required": ["releaseId", "releaseDirectory", "immutable", "currentPointerPath", "catalogPath", "bindingStatus", "pendingReason", "consumerEligible", "publishEligible", "pathSemantics", "transports", "byteContract", "visibilityClasses", "producerCommitProvenance", "requiredReleaseEvidence"],
      "properties": {
        "releaseId": { "const": "UABC-PORTABLE-PILOT-0001" },
        "immutable": { "const": true },
        "bindingStatus": { "const": "UNBOUND_LOCAL_PILOT" },
        "pendingReason": { "const": "PENDING_BCPROJECTOS_RELEASE" },
        "consumerEligible": { "const": false },
        "publishEligible": { "const": false },
        "pathSemantics": { "const": "repository-relative" },
        "byteContract": { "const": "identical-canonical-bytes" },
        "releaseDirectory": { "$ref": "#/$defs/safePath" },
        "currentPointerPath": { "$ref": "#/$defs/safePath" },
        "catalogPath": { "$ref": "#/$defs/safePath" },
        "transports": { "const": ["filesystem", "https"] },
        "visibilityClasses": { "const": ["customer", "internal"] },
        "producerCommitProvenance": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "requiredReleaseEvidence": { "const": ["annotatedTag", "peeledCommit", "finalManifest", "productDigest"] }
      }
    },
    "customerCatalog": { "type": "object" }
  },
  "$defs": {
    "safePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*[\\\\\\u0000-\\u001F\\u007F])(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$" }
  }
}
