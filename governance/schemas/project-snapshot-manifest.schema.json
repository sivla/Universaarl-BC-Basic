{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universaarl:schema:project-snapshot-manifest:v1",
  "title": "Universaarl-Spectra-Snapshotmanifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producerId", "projectId", "contractId", "producerCommitSha", "schemaPath", "indexPath", "consumer", "spectraReleaseBinding", "consumerBindingDigest", "payloadDigestFormat", "index", "payloads", "payloadBundleDigest", "validationStatus"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "producerId": { "const": "blueprint" },
    "projectId": { "const": "UABC-BC-BASIC-001" },
    "contractId": { "const": "UABC-PROJECT-DATA-V1" },
    "producerCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "schemaPath": { "const": "governance/schemas/project-snapshot-manifest.schema.json" },
    "indexPath": { "const": "exports/project-data/v1/index.yaml" },
    "consumer": { "$ref": "#/$defs/consumer" },
    "spectraReleaseBinding": { "$ref": "#/$defs/spectraReleaseBinding" },
    "consumerBindingDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "payloadDigestFormat": { "const": "uabc-snapshot-records-v1" },
    "index": { "$ref": "#/$defs/indexRecord" },
    "payloads": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/payloadRecord" } },
    "payloadBundleDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validationStatus": { "const": "validated" }
  },
  "$defs": {
    "safePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*[\\\\\\u0000-\\u001F\\u007F])(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "consumer": {
      "type": "object", "additionalProperties": false,
      "required": ["consumerId", "repositoryUrl", "branch", "access"],
      "properties": {
        "consumerId": { "const": "project-twin" },
        "repositoryUrl": { "const": "https://github.com/sivla/FiBu.git" },
        "branch": { "const": "codex/universaarl-projekt-twin" },
        "access": { "const": "nur-lesend" }
      }
    },
    "spectraReleaseBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingStatus", "productId", "technicalRepositoryName", "repositoryUrl", "releaseVersion", "releaseTag", "tagCommit", "manifestPath", "manifestSourceCommit", "consumerMode", "installableBlueprint", "digestAlgorithm", "payloadBundleDigest"],
      "properties": {
        "bindingStatus": { "const": "BOUND" },
        "productId": { "const": "spectra" },
        "technicalRepositoryName": { "const": "BCProjectOS" },
        "repositoryUrl": { "const": "https://github.com/sivla/BCProjectOS.git" },
        "releaseVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
        "releaseTag": { "type": "string", "pattern": "^spectra-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
        "tagCommit": { "$ref": "#/$defs/commit" },
        "manifestPath": { "$ref": "#/$defs/safePath" },
        "manifestSourceCommit": { "$ref": "#/$defs/commit" },
        "consumerMode": { "const": "INSTALLABLE_BLUEPRINT" },
        "installableBlueprint": { "const": true },
        "digestAlgorithm": { "const": "SHA-256" },
        "payloadBundleDigest": { "$ref": "#/$defs/sha" }
      }
    },
    "indexRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "gitMode", "sizeBytes", "sha256"],
        "properties": { "path": { "const": "exports/project-data/v1/index.yaml" }, "gitMode": { "const": "100644" }, "sizeBytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha" } }
    },
    "payloadRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "selector", "gitMode", "sizeBytes", "sha256"],
        "properties": { "id": { "type": "string", "pattern": "^UABC-[A-Z0-9-]+$" }, "path": { "$ref": "#/$defs/safePath" }, "selector": { "type": ["string", "null"] }, "gitMode": { "const": "100644" }, "sizeBytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha" } }
    }
  }
}
