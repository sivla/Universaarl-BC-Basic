{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universaarl:schema:setup-wave-1-projection:v1",
  "title": "Setup-Wave-1-Projektion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exportId", "recordType", "readOnly", "writesAuthorized", "target", "configurationState", "packages", "preflight", "writeGate", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportId": { "const": "UABC-EXP-SETUP-WAVE1-001" },
    "recordType": { "const": "setup-wave-1-projection" },
    "readOnly": { "const": true },
    "writesAuthorized": { "const": false },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "companyId", "platform", "application", "pilotName", "legacyName"],
      "properties": {
        "environment": { "const": "Playthru" },
        "companyId": { "const": "UABC-BASIC-DE" },
        "platform": { "const": "28.0.52286.0" },
        "application": { "const": "28.2.50931.52241" },
        "pilotName": { "const": "Universaarl GmbH (BC Basic Pilot)" },
        "legacyName": { "const": "Universaarl GmbH (Legacy)" }
      }
    },
    "configurationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineKind", "baselineProvenance", "pilotConfigured", "writesApplied", "readbackStatus", "technicalCompanyName", "internalCompanyId", "observedDisplayName", "targetDisplayName", "targetDecision", "resetDecision", "targetState", "appliedDifference", "wave0ReadbackAttempt", "companyStrategyGate"],
      "properties": {
        "baselineKind": { "const": "standard-cronus-demo" },
        "baselineProvenance": { "const": "microsoft-standard-cronus-demo-data" },
        "pilotConfigured": { "const": false },
        "writesApplied": { "const": false },
        "readbackStatus": { "const": "pending" },
        "technicalCompanyName": { "const": "UABC-BASIC-DE" },
        "internalCompanyId": { "type": "null" },
        "observedDisplayName": { "const": "Universaarl GmbH" },
        "targetDisplayName": { "const": "Universaarl GmbH (BC Basic Pilot)" },
        "targetDecision": { "const": "pending-wave-0-evidence" },
        "resetDecision": { "const": "pending-resetpoint-evidence" },
        "targetState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "displayName", "configurationScope", "laterLockedWaves"],
          "properties": {
            "classification": { "const": "bc-basic-target-not-applied" },
            "displayName": { "const": "Universaarl GmbH (BC Basic Pilot)" },
            "configurationScope": { "type": "string", "minLength": 40 },
            "laterLockedWaves": { "const": ["UABC-02-TRADE-MASTER", "UABC-03-OPENING-DATA"] }
          }
        },
        "appliedDifference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "readbackStatus", "readbackEvidenceCount"],
          "properties": {
            "status": { "const": "none-evidenced" },
            "readbackStatus": { "const": "pending" },
            "readbackEvidenceCount": { "const": 0 }
          }
        },
        "wave0ReadbackAttempt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidencePath", "bcReadbackAuthority", "bcFieldValuesRead", "screenshotCaptured", "writesPerformed", "visibleTabTarget"],
          "properties": {
            "status": { "const": "blocked-before-dom-readback" },
            "evidencePath": { "const": "evidence/playthru-uabc-basic-de/wave-0-company-identity-readback.yaml" },
            "bcReadbackAuthority": { "const": false },
            "bcFieldValuesRead": { "const": false },
            "screenshotCaptured": { "const": false },
            "writesPerformed": { "const": false },
            "visibleTabTarget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "environmentParameter", "companyParameter"],
              "properties": {
                "title": { "const": "Dynamics 365 Business Central" },
                "environmentParameter": { "const": "Playthru" },
                "companyParameter": { "const": "UABC-BASIC-DE" }
              }
            }
          }
        },
        "companyStrategyGate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "selectedOption", "allowedOptions", "requiredEvidence", "decisionEvidenceCount", "decisionAuthority", "nextExecutableStep", "writesAuthorized"],
          "properties": {
            "status": { "const": "blocked-pending-wave0-and-reset-evidence" },
            "selectedOption": { "type": "null" },
            "allowedOptions": { "const": ["controlled-reuse-of-dedicated-cronus-copy", "clean-new-company-or-copy"] },
            "requiredEvidence": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
            "decisionEvidenceCount": { "const": 0 },
            "decisionAuthority": { "const": "project/bc-basic/pilot-setup-baseline.yaml#/companyInformation/companyStrategyDecision" },
            "nextExecutableStep": { "const": "W0-01-read-company-identity" },
            "writesAuthorized": { "const": false }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId", "status", "tables", "records", "errors"],
        "properties": {
          "packageId": { "type": "string" },
          "status": { "type": "string" },
          "tables": { "const": 0 },
          "records": { "const": 0 },
          "errors": { "const": 0 }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "wave0Status", "workingDate", "operator", "locale", "resetPoint"],
      "properties": {
        "status": { "const": "beobachtet-nur-lesend" },
        "wave0Status": { "const": "blocked-before-dom-readback" },
        "workingDate": { "const": "2026-07-13" },
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userId", "permissionSet"],
          "properties": {
            "userId": { "const": "KAJETAN.KALICKI" },
            "permissionSet": { "const": "SUPER" }
          }
        },
        "locale": { "const": "German (Germany)" },
        "resetPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "requiredBeforeAnyWrite"],
          "properties": {
            "status": { "const": "missing-blocker" },
            "requiredBeforeAnyWrite": { "const": true }
          }
        }
      }
    },
    "writeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writesAuthorized", "noGoSteps", "nextAllowedStep"],
      "properties": {
        "writesAuthorized": { "const": false },
        "noGoSteps": { "const": ["RUN-06", "RUN-07", "RUN-08", "RUN-09", "RUN-10", "RUN-11", "RUN-12", "RUN-13", "RUN-14", "RUN-15", "RUN-16", "RUN-17", "RUN-18", "RUN-19", "RUN-20", "RUN-21", "RUN-22"] },
        "nextAllowedStep": { "const": "W0-01-read-company-identity" }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "role": { "type": "string" }
        }
      }
    }
  }
}
