{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universaarl.example.invalid/schemas/core-finance-payload.schema.json",
  "title": "UABC CORE-FINANCE Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payloadId", "projectId", "packageId", "packageName", "status", "classification", "target", "truthBoundary", "gates", "taxAssumption", "sourceContracts", "preparationWorklog", "controlTotals", "accountRoles", "packageTables", "manualSteps", "executionContract"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "payloadId": { "const": "UABC-PAYLOAD-CORE-FINANCE-001" },
    "projectId": { "const": "UABC-BC-PILOT-001" },
    "packageId": { "const": "UABC-01-CORE-FINANCE" },
    "packageName": { "const": "Kern und Finanzwesen" },
    "status": { "const": "prepared-for-controlled-live-run" },
    "classification": { "const": "synthetischer-consultant-setup-payload" },
    "target": { "$ref": "#/$defs/target" },
    "truthBoundary": { "$ref": "#/$defs/truthBoundary" },
    "gates": { "$ref": "#/$defs/gates" },
    "taxAssumption": { "$ref": "#/$defs/taxAssumption" },
    "sourceContracts": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^(project|evidence)/" } },
    "preparationWorklog": { "$ref": "#/$defs/worklog" },
    "controlTotals": { "$ref": "#/$defs/controlTotals" },
    "accountRoles": { "type": "array", "minItems": 11, "maxItems": 11, "items": { "$ref": "#/$defs/accountRole" } },
    "packageTables": { "type": "array", "minItems": 19, "maxItems": 19, "items": { "$ref": "#/$defs/table" } },
    "manualSteps": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/table" } },
    "executionContract": { "$ref": "#/$defs/executionContract" }
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["environment", "technicalCompanyName", "baselineKind", "targetDisplayName"],
      "properties": {
        "environment": { "const": "Playthru" },
        "technicalCompanyName": { "const": "UABC-BASIC-DE" },
        "baselineKind": { "const": "standard-cronus-demo" },
        "targetDisplayName": { "const": "Universaarl GmbH (BC Basic Pilot)" }
      }
    },
    "truthBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["bcReadbackAuthority", "customerTargetRealized", "pilotConfigured", "writesApplied", "writesAuthorized", "packageApplied", "customerAccepted", "liveEvidence"],
      "properties": {
        "bcReadbackAuthority": { "const": false }, "customerTargetRealized": { "const": false }, "pilotConfigured": { "const": false }, "writesApplied": { "const": false }, "writesAuthorized": { "const": false }, "packageApplied": { "const": false }, "customerAccepted": { "const": false },
        "liveEvidence": { "type": "object", "additionalProperties": false, "required": ["tables", "records", "errors"], "properties": { "tables": { "const": 0 }, "records": { "const": 0 }, "errors": { "const": 0 } } }
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredBeforePackageDefinition", "requiredBeforeImport", "requiredBeforeApply", "status"],
      "properties": {
        "requiredBeforePackageDefinition": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "requiredBeforeImport": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "requiredBeforeApply": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "status": { "const": "blocked-before-dom-readback" }
      }
    },
    "taxAssumption": {
      "type": "object", "additionalProperties": false,
      "required": ["jurisdiction", "standardVatPercent", "truthClass", "confirmationStatus", "confirmationRequiredBeforeApply", "legalOrTaxAdviceClaimed"],
      "properties": {
        "jurisdiction": { "const": "DE" }, "standardVatPercent": { "const": 19 }, "truthClass": { "const": "synthetic-project-assumption" }, "confirmationStatus": { "const": "open" }, "confirmationRequiredBeforeApply": { "const": true }, "legalOrTaxAdviceClaimed": { "const": false }
      }
    },
    "worklog": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "taskId", "date", "role", "actorRef", "actorType", "actionRole", "hours", "activity", "phase", "billable", "hourlyRate", "netAmount"],
      "properties": {
        "id": { "const": "WL-UABC-40-CORE-PREP-20260713" }, "taskId": { "const": "UABC-40" }, "date": { "const": "2026-07-13" }, "role": { "const": "Lead BC Consultant" }, "actorRef": { "const": "P-PILOT-LEAD-001" }, "actorType": { "const": "human" }, "actionRole": { "type": "string", "minLength": 20 }, "hours": { "type": "number", "exclusiveMinimum": 0 }, "activity": { "type": "string", "minLength": 80 }, "phase": { "const": "P2" }, "billable": { "const": true }, "hourlyRate": { "const": 120 }, "netAmount": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "controlTotals": {
      "type": "object", "additionalProperties": false,
      "required": ["packageTableCount", "packageRecordCount", "manualTableCount", "manualRecordCount", "totalTableCount", "totalRecordCount", "accountRoleCount", "dimensionCount", "dimensionValueCount", "numberSeriesCount", "numberSeriesLineCount", "paymentTermsCount", "realBankIdentifierCount"],
      "properties": {
        "packageTableCount": { "type": "integer", "minimum": 1 }, "packageRecordCount": { "type": "integer", "minimum": 1 }, "manualTableCount": { "type": "integer", "minimum": 1 }, "manualRecordCount": { "type": "integer", "minimum": 1 }, "totalTableCount": { "type": "integer", "minimum": 1 }, "totalRecordCount": { "type": "integer", "minimum": 1 }, "accountRoleCount": { "const": 11 }, "dimensionCount": { "const": 2 }, "dimensionValueCount": { "const": 5 }, "numberSeriesCount": { "const": 9 }, "numberSeriesLineCount": { "const": 9 }, "paymentTermsCount": { "const": 2 }, "realBankIdentifierCount": { "const": 0 }
      }
    },
    "accountRole": {
      "type": "object", "additionalProperties": false,
      "required": ["roleId", "accountNo", "name", "class"],
      "properties": { "roleId": { "type": "string", "pattern": "^[A-Z0-9-]+$" }, "accountNo": { "type": "string", "pattern": "^[0-9]{5}$" }, "name": { "type": "string", "minLength": 5 }, "class": { "enum": ["balance-sheet", "income-statement"] } }
    },
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["tableId", "tableName", "page", "mode", "order", "naturalKey", "requiredFields", "optionalFields", "excludedFields", "dependsOn", "expectedEffect", "rollback", "evidenceTarget", "records"],
      "properties": {
        "tableId": { "type": "integer", "minimum": 1 }, "tableName": { "type": "string", "minLength": 2 }, "page": { "type": "string", "minLength": 2 }, "mode": { "enum": ["configuration-package", "manual-ui-readback"] }, "order": { "type": "integer", "minimum": 1 },
        "naturalKey": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "requiredFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "optionalFields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "excludedFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } },
        "expectedEffect": { "type": "string", "minLength": 20 }, "rollback": { "type": "string", "minLength": 20 }, "evidenceTarget": { "type": "string", "pattern": "^evidence/" },
        "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } }
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["recordId", "key", "expectedOperation", "fields", "foreignKeys"],
      "properties": {
        "recordId": { "type": "string", "pattern": "^[A-Z0-9-]+$" }, "key": { "type": "object", "minProperties": 1 }, "expectedOperation": { "enum": ["create-or-update-after-readback", "create-or-no-op-after-readback", "update-after-readback"] }, "fields": { "type": "object", "minProperties": 1 },
        "foreignKeys": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["field", "tableId", "target"], "properties": { "field": { "type": "string" }, "tableId": { "type": "integer" }, "target": { "type": "string", "pattern": "^[^=]+=.+$" } } } }
      }
    },
    "executionContract": {
      "type": "object", "additionalProperties": false,
      "required": ["packageToolAudience", "customerTrainingScope", "importFlow", "expectedErrors", "afterApplyControls", "stopConditions", "correctionScope"],
      "properties": {
        "packageToolAudience": { "const": "bc-consultant-only" }, "customerTrainingScope": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "importFlow": { "type": "array", "minItems": 5, "items": { "type": "string" } }, "expectedErrors": { "type": "array", "minItems": 4, "items": { "type": "object" } }, "afterApplyControls": { "type": "array", "minItems": 5, "items": { "type": "string" } }, "stopConditions": { "type": "array", "minItems": 8, "items": { "type": "string" } }, "correctionScope": { "type": "string", "minLength": 50 }
      }
    }
  }
}
