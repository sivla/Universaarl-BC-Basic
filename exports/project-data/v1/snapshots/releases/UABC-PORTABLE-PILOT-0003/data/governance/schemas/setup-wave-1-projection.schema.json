        "accountRoleCount": { "const": 11 },
        "dimensionCount": { "const": 2 },
        "dimensionValueCount": { "const": 5 },
        "numberSeriesCount": { "const": 9 },
        "numberSeriesLineCount": { "const": 9 },
        "paymentTermsCount": { "const": 2 },
        "realBankIdentifierCount": { "const": 0 },
