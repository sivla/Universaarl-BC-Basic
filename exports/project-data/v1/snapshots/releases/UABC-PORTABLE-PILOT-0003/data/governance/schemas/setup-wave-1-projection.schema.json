            "properties": {
              "stageId": { "type": "string", "pattern": "^R[0-9]-[A-Z0-9-]+$" },
              "order": { "type": "integer", "minimum": 0, "maximum": 9 },
              "name": { "type": "string", "minLength": 20 },
              "status": { "enum": ["blocked-before-dom-readback", "geplant-blockiert-durch-R0", "prepared-blocked-by-gates", "planned"] },
              "dependencyStageIds": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "type": "string" } },
              "ticketRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^UABC-[0-9]+$" } },
              "bcWriteRequired": { "type": "boolean" },
              "writeAuthorized": { "const": false },
              "completed": { "const": false },
              "entryCriteriaCount": { "type": "integer", "minimum": 1 },
              "plannedActionCount": { "type": "integer", "minimum": 1 },
              "exitCriteriaCount": { "type": "integer", "minimum": 1 },
              "evidenceTargetCount": { "type": "integer", "minimum": 1 },
              "executionEvidenceCount": { "const": 0 },
              "stopOrRollbackDefined": { "const": true }
