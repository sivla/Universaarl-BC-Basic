{
  "name": "universaarl-bc-blueprint-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Nachweisbasierter, durch OpenSpec gesteuerter Implementierungsblueprint fuer Business Central",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "validate:openspec-schema": "openspec schema validate universaarl-delivery",
    "validate:openspec": "openspec validate --all --strict --no-interactive",
    "validate:references": "node scripts/validate-project.mjs",
    "validate:snapshot-contract": "node scripts/validate-snapshot-contract.mjs",
    "generate:portable-snapshot-pilot": "node scripts/generate-portable-snapshot-pilot.mjs --write",
    "validate:portable-snapshot-pilot": "node scripts/validate-portable-snapshot-pilot.mjs",
    "test:portable-snapshot-pilot": "node --test tests/governance/portable-snapshot-pilot.test.mjs",
    "validate:production-readiness": "node scripts/validate-production-readiness.mjs",
    "generate:reference-simulation": "node scripts/generate-reference-simulation.mjs",
    "validate:reference-simulation": "node scripts/validate-reference-simulation.mjs",
    "test:reference-simulation": "node --test tests/governance/reference-simulation.test.mjs",
    "test:production-readiness": "node --test tests/governance/production-readiness.test.mjs",
    "generate:document-catalog": "node scripts/generate-document-catalog.mjs --write",
    "validate:document-catalog": "node scripts/validate-document-catalog.mjs",
    "generate:three-space": "node scripts/generate-three-space-confluence.mjs",
    "validate:three-space": "node scripts/validate-three-space-confluence.mjs",
    "test:three-space": "node --test tests/governance/three-space-confluence.test.mjs",
    "generate:atlassian-materialization": "node scripts/generate-atlassian-materialization.mjs --write",
    "validate:atlassian-materialization": "node scripts/generate-atlassian-materialization.mjs",
    "test:document-catalog": "node --test tests/governance/document-catalog.test.mjs",
    "validate:simulation": "node scripts/validate-simulation-evidence.mjs",
    "validate:simulation:historical": "node scripts/validate-simulation-evidence.mjs --historical",
    "validate:bc-playthrough": "node scripts/validate-bc-playthrough.mjs",
    "validate:bc-playthrough:historical": "node scripts/validate-bc-playthrough.mjs --historical",
    "validate:project-story": "node scripts/validate-project-story.mjs",
    "validate:canonical-project": "node scripts/validate-canonical-project.mjs",
    "generate:twin-catalog": "node scripts/generate-twin-catalog.mjs",
    "validate:twin-catalog": "node scripts/validate-twin-catalog.mjs",
    "generate:twin-catalog-v2": "node scripts/generate-twin-catalog-v2.mjs",
    "realize:pilot-v3": "node scripts/realize-bc-basic-pilot-v3.mjs",
    "validate:pilot-v3": "node scripts/validate-bc-basic-pilot-v3.mjs",
    "test:pilot-v3": "node --test tests/governance/bc-basic-pilot-v3.test.mjs",
    "materialize:operating-cycle-v4": "node scripts/materialize-bc-operating-cycle-v4.mjs",
    "finalize:operating-cycle-v4": "node scripts/finalize-bc-operating-cycle-v4.mjs",
    "validate:operating-cycle-v4": "node scripts/validate-bc-operating-cycle-v4.mjs",
    "validate:operating-cycle-v4-catalog": "node scripts/validate-bc-operating-cycle-v4-catalog.mjs",
    "test:operating-cycle-v4": "node --test tests/governance/bc-operating-cycle-v4.test.mjs",
    "generate:twin-catalog-v3": "node scripts/generate-twin-catalog-v3.mjs",
    "validate:ticket-quality-v2": "node scripts/validate-ticket-quality-v2.mjs",
    "test:ticket-quality-v2": "node --test tests/story/ticket-quality-v2.test.mjs tests/governance/twin-catalog-bundle-digest.test.mjs tests/governance/twin-catalog-bound-files.test.mjs",
    "generate:jira-story-realism": "node scripts/enrich-jira-story-realism.mjs --write",
    "validate:jira-story-realism": "node scripts/validate-jira-story-realism.mjs",
    "test:jira-story-realism": "node --test tests/story/jira-story-realism.test.mjs",
    "validate:pilot-setup": "node scripts/validate-pilot-setup-baseline.mjs",
    "validate:setup-wave1": "node scripts/validate-setup-wave-1.mjs",
    "test:pilot-setup": "node --test tests/governance/pilot-setup-baseline.test.mjs",
    "test:setup-wave1": "node --test tests/governance/setup-wave-1.test.mjs",
    "generate:core-finance": "node scripts/generate-core-finance-package.mjs",
    "validate:core-finance": "node scripts/validate-core-finance-package.mjs",
    "test:core-finance": "node --test tests/governance/core-finance-package.test.mjs",
    "generate:setup-wave1-export": "node scripts/generate-setup-wave-1-export.mjs",
    "validate:setup-wave1-export": "node scripts/validate-setup-wave-1-export.mjs",
    "test:setup-wave1-export": "node --test tests/governance/setup-wave-1-export.test.mjs",
    "validate:spectra-conformance": "node scripts/validate-spectra-0.10-integration.mjs",
    "validate:active-ticket-contract": "node scripts/validate-active-ticket-contract-source.mjs",
    "generate:spectra010": "node scripts/generate-spectra-0.10-integration.mjs --write",
    "validate:spectra010": "node scripts/validate-spectra-0.10-integration.mjs",
    "test:project-story": "node --test tests/story/project-story-validator.test.mjs",
    "test:canonical-project": "node --test tests/governance/canonical-project.test.mjs",
    "test:spectra-conformance": "node --test tests/story/spectra-0.7-conformance.test.mjs",
    "test:spectra010": "node --test tests/story/spectra-0.10-integration.test.mjs",
    "generate:snapshot": "node scripts/generate-project-snapshot.mjs",
    "validate:archive-ready": "npm run validate:openspec-schema && npm run validate:openspec && node scripts/validate-project.mjs --archive-ready",
    "test": "npm run validate:openspec-schema && npm run validate:openspec && npm run validate:pilot-v3 && npm run test:pilot-v3 && npm run validate:operating-cycle-v4 && npm run validate:operating-cycle-v4-catalog && npm run test:operating-cycle-v4 && npm run validate:canonical-project && npm run validate:twin-catalog && npm run validate:ticket-quality-v2 && npm run test:ticket-quality-v2 && npm run validate:production-readiness && npm run test:production-readiness && npm run validate:core-finance && npm run test:core-finance && npm run validate:project-story && npm run validate:jira-story-realism && npm run validate:active-ticket-contract && npm run validate:simulation && npm run validate:simulation:historical && npm run validate:bc-playthrough && npm run validate:bc-playthrough:historical && npm run test:current-historical-truth && npm run test:project-story && npm run test:canonical-project && npm run test:jira-story-realism && npm run validate:spectra010 && npm run test:spectra010 && npm run test:portable-snapshot-pilot && npm run test:language && npm run test:german && npm run test:governance && npm run test:walkthrough && npm run validate:references",
    "test:current-historical-truth": "node --test tests/governance/current-historical-truth.test.mjs",
    "test:language": "node --test tests/language/*.test.mjs",
    "test:german": "node scripts/check-german.mjs",
    "test:governance": "node --test tests/governance/*.test.mjs",
    "check:media-toolchain": "node scripts/check-media-toolchain.mjs",
    "setup:playwright:chromium": "node scripts/setup-playwright-chromium.mjs",
    "validate:walkthrough-manifest": "node scripts/validate-walkthrough-manifest.mjs",
    "build:walkthrough:baseline": "node scripts/build-walkthrough.mjs",
    "artifacts:walkthrough": "npm run build:walkthrough:baseline",
    "test:walkthrough:html": "node scripts/run-playwright-local.mjs test --config=playwright.walkthrough.config.mjs",
    "test:walkthrough": "npm run check:media-toolchain && npm run setup:playwright:chromium && npm run build:walkthrough:baseline && node --test tests/artifacts/media-toolchain.test.mjs tests/artifacts/walkthrough.test.mjs && npm run test:walkthrough:html",
    "pw:baseline": "npm run setup:playwright:chromium && node scripts/run-playwright-local.mjs test tests/playwright/environment-baseline.spec.mjs",
    "pw:baseline:headed": "npm run setup:playwright:chromium && node scripts/run-playwright-local.mjs test tests/playwright/environment-baseline.spec.mjs --headed",
    "pw:baseline:compare": "node tests/playwright/helpers/bc-evidence.mjs compare"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.5.0",
    "@playwright/test": "1.61.1",
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
